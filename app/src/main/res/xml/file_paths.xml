<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only explicitly staged chat attachments and converted prompts may be shared. -->
    <files-path name="attachments" path="attachments/" />
    <!-- Generated AIRI artifacts; ArtifactManager validates the canonical path before sharing. -->
    <files-path name="workspace_artifacts" path="workspace/artifacts/" />
    <!-- Files written by the agent's write_file tool; AgentFileExporter validates the name before sharing. -->
    <files-path name="agent_files" path="agent_files/" />
    <cache-path name="chat_attachments" path="chat_attachments/" />
</paths>
