<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Calendar: read/write events (requires runtime grant) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Alarms -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Contacts: read-only (requires runtime grant) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Accessibility: agent execution layer -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".app.AIRIApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AIRI">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!--
            Disable Crashlytics auto-collection at install time.
            Collection is enabled at runtime via FirebaseCrashReporter.enableCollection()
            ONLY after the user grants crash-reporting consent in OnboardingScreen /
            SettingsScreen (TelemetryConsentStore.setCrashReportingEnabled(true)).
            This satisfies GDPR / Play Store data safety requirements.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
            Defer Firebase Analytics data collection until explicitly enabled.
            Analytics collection is enabled at runtime ONLY after the user
            grants analytics consent in OnboardingScreen / SettingsScreen
            (TelemetryConsentStore.setAnalyticsEnabled(true)).
            This satisfies GDPR / Play Store data safety requirements.
        -->
        <meta-data
            android:name="firebase_analytics_collection_deferred"
            android:value="true" />

        <!-- 
            MainActivity is exported because it is the primary LAUNCHER entry point.
            It also handles ASSIST and VOICE_COMMAND intents for system integration.
            No privileged internal-only functionality is exposed via this activity; 
            all sensitive operations require user authentication and/or biometric verification.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AIRI.NoActionBar"
            android:windowSoftInputMode="adjustResize">

            <!-- Launcher entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- System assistant integration — allows AIRI to be set as the default assistant -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Voice search / assistant activation -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="airi"
                    android:host="referral" />
            </intent-filter>

            <!-- OAuth callback deep-link — receives airi://oauth/callback?code=...
                 Used by future OAuth providers (Slack, Discord, Notion, Google Drive).
                 MainActivity routes this to IntegrationsViewModel.handleOAuthCallback(). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="airi"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>

        </activity>

        <service
            android:name=".tools.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            LiveVoiceService — bidirectional real-time voice conversation.
            Local pipeline: Vosk STT + Android TTS (LocalVoicePipeline, always available).
            Cloud pipeline: GeminiLiveProvider or OpenAIRealtimeProvider (when API key set).
            Activated via ChatScreen voice mode button after RECORD_AUDIO granted.
        -->
        <service
            android:name=".voice.LiveVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:enabled="true" />

        <!-- On-device wake-word listener ("Hey AIRI") — see HotwordService.kt -->
        <service
            android:name=".voice.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            AiriAccessibilityService — android:exported="true" is REQUIRED by Android
            for all AccessibilityService implementations. The binding is restricted by
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" which
            is a system-only permission (protectionLevel="signature"). No third-party
            app can bind this service. The exported=true here is not a security risk.
        -->
        <service
            android:name=".accessibility.service.AiriAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            FileProvider for sharing attachment files with other apps.
            android:exported="false" — this provider is NOT directly accessible
            by other apps; content:// URIs require explicit FLAG_GRANT_READ_URI_PERMISSION.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
