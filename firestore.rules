rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function devicePath(userId, deviceId) {
      return /databases/$(database)/documents/users/$(userId)/devices/$(deviceId);
    }

    function deviceExists(userId, deviceId) {
      return exists(devicePath(userId, deviceId));
    }

    function pairedDevice(userId, deviceId, platform) {
      return deviceExists(userId, deviceId)
        && get(devicePath(userId, deviceId)).data.ownerId == userId
        && get(devicePath(userId, deviceId)).data.platform == platform
        && get(devicePath(userId, deviceId)).data.status == 'PAIRED';
    }

    function activeSession(userId, deviceId, sessionId) {
      return exists(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)/sessions/$(sessionId))
        && get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)/sessions/$(sessionId)).data.ownerId == userId
        && get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)/sessions/$(sessionId)).data.desktopDeviceId == deviceId
        && get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)/sessions/$(sessionId)).data.revoked == false
        && get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)/sessions/$(sessionId)).data.expiresAt > request.time;
    }

    function validDevice(userId, deviceId) {
      return request.resource.data.keys().hasOnly([
          'deviceId', 'ownerId', 'displayName', 'platform', 'createdAt', 'lastSeenAt', 'status', 'capabilities'
        ])
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerId == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.platform in ['ANDROID', 'DESKTOP']
        && request.resource.data.status in ['PENDING', 'PAIRED', 'REVOKED', 'OFFLINE']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.capabilities is list
        && request.resource.data.capabilities.size() <= 8;
    }

    function commandPayloadIsValid() {
      let payload = request.resource.data.payload;
      let text = payload.get('text', '');
      return (
          request.resource.data.commandType == 'SUBMIT_TEXT_REQUEST'
          && payload.keys().hasOnly(['text'])
          && text is string
          && text.size() > 0
          && text.size() <= 8000
        ) || (
          request.resource.data.commandType in ['REQUEST_STATUS', 'SYNC_STATE', 'START_NEW_DRAFT', 'CANCEL_OWNED_REQUEST']
          && payload.keys().hasOnly([])
        );
    }

    function validCommand(userId, deviceId, commandId) {
      return request.resource.data.keys().hasOnly([
          'commandId', 'ownerId', 'desktopDeviceId', 'controllerDeviceId', 'sessionId', 'commandType', 'payload', 'sequence', 'createdAt', 'expiresAt', 'correlationId'
        ])
        && request.resource.data.commandId == commandId
        && request.resource.data.ownerId == userId
        && request.resource.data.desktopDeviceId == deviceId
        && request.resource.data.controllerDeviceId is string
        && request.resource.data.sessionId is string
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm')
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() <= 128
        && request.resource.data.commandType in ['REQUEST_STATUS', 'SYNC_STATE', 'START_NEW_DRAFT', 'SUBMIT_TEXT_REQUEST', 'CANCEL_OWNED_REQUEST']
        && request.resource.data.payload is map
        && pairedDevice(userId, request.resource.data.controllerDeviceId, 'ANDROID')
        && pairedDevice(userId, deviceId, 'DESKTOP')
        && activeSession(userId, deviceId, request.resource.data.sessionId)
        && commandPayloadIsValid();
    }

    function validMemory(memoryId) {
      return request.resource.data.keys().hasOnly([
          'memoryId', 'role', 'content', 'emotionState', 'sessionId', 'timestamp',
          'isMemory', 'projectId', 'memorySource', 'provenance', 'confidence',
          'importance', 'memoryScope', 'privacyLevel', 'expiresAtMs', 'updatedAtMs',
          'deleted'
        ])
        && request.resource.data.memoryId == memoryId
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAtMs is int
        && (request.resource.data.deleted == true || (
          request.resource.data.isMemory == true
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.role is string
          && request.resource.data.sessionId is string
          && request.resource.data.provenance.size() <= 500
        ));
    }

    function validMemoryCursor() {
      return request.resource.data.keys().hasOnly(['cursorUpdatedAtMs', 'lastSyncMs'])
        && request.resource.data.cursorUpdatedAtMs is int
        && request.resource.data.lastSyncMs is int;
    }

    // P1/P2: deletion requests. A signed-in user may FILE a request for their OWN data and read
    // their own requests; only the processAccountDeletionRequest Cloud Function (Admin SDK) can
    // change `status`, so a "completed" verdict cannot be forged from the device.
    match /accountDeletionRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['account', 'memory']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // B2: purchase claims. A client may FILE a claim (status must be 'pending') and read its
    // own claims; only the verifyPlayPurchaseClaim Cloud Function (Admin SDK) can change
    // `status`, so the verdict cannot be forged from the device.
    match /users/{userId}/purchaseClaims/{claimId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly(['packageName', 'productId', 'purchaseToken', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.packageName is string
        && request.resource.data.packageName.size() <= 128
        && request.resource.data.productId in ['premium_monthly', 'pro_annual']
        && request.resource.data.purchaseToken is string
        && request.resource.data.purchaseToken.size() > 0
        && request.resource.data.purchaseToken.size() <= 4096
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/profile/{profileId} {
      allow read, write: if ownsUser(userId) && profileId == 'preferences';
    }

    match /users/{userId}/sync_meta/{metaId} {
      allow read: if ownsUser(userId);
      allow create, update: if ownsUser(userId)
        && (metaId == 'memory' && validMemoryCursor()
            || metaId == 'device');
      allow delete: if false;
    }

    match /users/{userId}/memory/{memoryId} {
      allow read: if ownsUser(userId);
      allow create, update: if ownsUser(userId) && validMemory(memoryId);
      allow delete: if false;
    }

    // Report 3, S3: owner-only, and writes are limited to the exact fields the app
    // sends, with bounded types and sizes (no arbitrary documents under this path).
    function optString(data, key, maxLen) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function validContinuity(userId, taskId) {
      let d = request.resource.data;
      return ownsUser(userId)
        && d.keys().hasOnly(['schemaVersion', 'taskId', 'projectId', 'status', 'updatedAtMs',
                             'currentRunId', 'currentStepId', 'progressPercent', 'plan'])
        && d.keys().hasAll(['taskId', 'status', 'updatedAtMs'])
        && d.taskId == taskId
        && taskId.size() <= 128
        && d.status is string && d.status.size() <= 40
        && d.updatedAtMs is int
        && (!('schemaVersion' in d) || d.schemaVersion is int)
        && (!('progressPercent' in d) || d.progressPercent is int)
        && optString(d, 'projectId', 128)
        && optString(d, 'currentRunId', 128)
        && optString(d, 'currentStepId', 128)
        && (!('plan' in d) || (d.plan is list && d.plan.size() <= 100));
    }

    match /users/{userId}/task_continuity/{taskId} {
      allow read: if ownsUser(userId);
      allow create, update: if validContinuity(userId, taskId);
      allow delete: if ownsUser(userId);
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && validDevice(userId, deviceId)
        && request.resource.data.platform == 'ANDROID'
        && request.resource.data.status == 'PENDING';
      allow update, delete: if false;

      match /sessions/{sessionId} {
        allow read: if ownsUser(userId);
        allow create, update, delete: if false;
      }

      match /commands/{commandId} {
        allow read: if ownsUser(userId);
        allow create: if ownsUser(userId) && validCommand(userId, deviceId, commandId);
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if ownsUser(userId);
        allow create, update, delete: if false;
      }
    }
  }
}
