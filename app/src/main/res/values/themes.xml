<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base AIRI application theme -->
    <style name="Theme.AIRI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0A0E27</item>
        <item name="android:navigationBarColor">#0A0E27</item>
    </style>

    <!-- Activity theme: full screen for Compose, no action bar -->
    <style name="Theme.AIRI.NoActionBar" parent="Theme.AIRI">
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
